import pandas as pd

#Função para preparar o FVA

def preparar_fva(fva_df, model, solution):
    """
    Adiciona informações extras ao resultado do FVA e organiza as colunas.
    """

    # Criar uma cópia para não alterar o DataFrame original
    fva = fva_df.copy()

    # Fluxo da solução ótima da FBA
    fva["flux_FBA"] = solution.fluxes

    # Nome da reação
    fva["name"] = [
        model.reactions.get_by_id(rxn).name
        for rxn in fva.index
    ]

    # Equação
    fva["equation"] = [
        model.reactions.get_by_id(rxn).reaction
        for rxn in fva.index
    ]

    # Compartimento
    fva["compartment"] = [
        ", ".join(sorted(model.reactions.get_by_id(rxn).compartments))
        for rxn in fva.index
    ]

    # Amplitude do FVA
    fva["range"] = fva["maximum"] - fva["minimum"]

    # Transformar o índice em coluna
    fva = fva.reset_index().rename(columns={"index": "reaction"})

    # Ordenar as colunas
    return fva[
        [
            "reaction",
            "name",
            "equation",
            "compartment",
            "flux_FBA",
            "minimum",
            "maximum",
            "range"
        ]
    ]


