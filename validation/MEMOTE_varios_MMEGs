# RODANDO MEMOTE PARA VARIOS MODELOS E GERANDO UM HTML PARA EXIBIÇÃO

from pathlib import Path
import subprocess
import html
import re


# ============================================================
# CONFIGURAÇÕES
# ============================================================

PASTA_MODELOS = Path("modelos")
PASTA_RESULTADOS = Path("resultados_memote")

# Solver utilizado pelo MEMOTE
SOLVER = "gurobi"

# ============================================================
# CRIAR PASTAS
# ============================================================

PASTA_RESULTADOS.mkdir(exist_ok=True)
PASTA_MODELOS.mkdir(exist_ok=True)

# ============================================================
# ENCONTRAR MODELOS
# ============================================================

modelos = sorted(PASTA_MODELOS.glob("*.xml"))

if not modelos:
    raise FileNotFoundError(
        f"Nenhum arquivo .xml encontrado em: {PASTA_MODELOS.resolve()}"
    )

print(f"{len(modelos)} modelo(s) encontrado(s):")

for modelo in modelos:
    print(f"  - {modelo.name}")


# ============================================================
# EXECUTAR MEMOTE
# ============================================================

resultados = []

for modelo in modelos:

    nome_modelo = modelo.stem

    pasta_modelo = PASTA_RESULTADOS / nome_modelo
    pasta_modelo.mkdir(exist_ok=True)

    arquivo_html = pasta_modelo / "report.html"

    print("\n" + "=" * 70)
    print(f"MODELO: {nome_modelo}")
    print("=" * 70)

    comando = [
        "memote",
        "report",
        "snapshot",
        str(modelo),
        "--filename",
        str(arquivo_html),
        "--solver",
        SOLVER
    ]

    print("Executando:")
    print(" ".join(comando))

    processo = subprocess.run(
        comando,
        capture_output=True,
        text=True
    )

    if processo.returncode == 0:

        print("✓ MEMOTE concluído")

        resultados.append({
            "modelo": nome_modelo,
            "arquivo": arquivo_html,
            "status": "Concluído"
        })

    else:

        print("✗ ERRO ao executar MEMOTE")
        print(processo.stderr)

        resultados.append({
            "modelo": nome_modelo,
            "arquivo": None,
            "status": "Erro"
        })


# ============================================================
# GERAR INDEX.HTML
# ============================================================

linhas = []

for resultado in resultados:

    nome = html.escape(resultado["modelo"])

    if resultado["arquivo"] is not None:

        link = f"{nome}/report.html"

        linhas.append(f"""
        <tr>
            <td><strong>{nome}</strong></td>
            <td class="success">✓ Concluído</td>
            <td>
                <a href="{link}" class="button">
                    Abrir relatório
                </a>
            </td>
        </tr>
        """)

    else:

        linhas.append(f"""
        <tr>
            <td><strong>{nome}</strong></td>
            <td class="error">✗ Erro</td>
            <td>-</td>
        </tr>
        """)


