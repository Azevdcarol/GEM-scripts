import pandas as pd

# Criar lista com informações das reações de troca
exchange_data = []

for rxn in model.exchanges:
    exchange_data.append({
        "Reação (ID)": rxn.id,
        "Nome da Reação": rxn.name,  # Nome descritivo da reação
        #"Metabólito Relacionado": list(rxn.metabolites.keys())[0].name,  # Nome do metabólito principal
        "Lower Bound": rxn.lower_bound,  # Fluxo mínimo permitido
        "Upper Bound": rxn.upper_bound   # Fluxo máximo permitido
    })

# Criar DataFrame
exchange_df = pd.DataFrame(exchange_data)


